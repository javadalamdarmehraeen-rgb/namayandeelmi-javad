          <button type="button" id="btnRunSearchInfo" class="btn btn-primary" style="background: #0d9488;">
            <span>🔍 جستجو و نمایش روی نقشه و لیست</span>
          </button>
          <button type="button" id="btnExportSearchInfoCSV" class="btn btn-success" style="background: #0d9488;">
            <span>⬇️ خروجی اکسل نتایج</span>
          </button>
        </div>
        <div id="map-search-info" class="map-container" style="height: 380px; margin-bottom: 1.5rem;"></div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>ردیف</th>
                <th>نام نماینده</th>
                <th>نوع مرکز</th>
                <th>نام مرکز / پزشک</th>
                <th>شهر / منطقه</th>
                <th>آدرس</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="tableSearchInfoBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>


  </main>

  <!-- ======================================================================
       BOTTOM OFFLINE / DIAGNOSTIC ORANGE BANNER (Matching Screenshot 8)
       "ارتباط با سرور برقرار نیست... لطفاً اتصال اینترنت خود را بررسی کنید..."
       ====================================================================== -->
  <div id="diagnosticOfflineBanner" class="offline-diagnostic-banner" style="display: none;">
    <div class="offline-banner-content">
      <div class="offline-icon">📡</div>
      <div class="offline-text">
        <h4>ارتباط با سرور برقرار نیست</h4>
        <p>لطفاً اتصال اینترنت خود را بررسی کنید. می‌توانید به کار ادامه دهید؛ اطلاعات ذخیره می‌شود و پس از وصل شدن ارسال خواهد شد.</p>
      </div>
    </div>
    <div class="offline-actions">
      <button type="button" class="btn-banner-retry" onclick="retryServerConnection()">🔄 بررسی مجدد</button>
      <button type="button" class="btn-banner-diag" onclick="switchTab('tab-troubleshooting'); document.getElementById('diagnosticOfflineBanner').style.display='none';">🛠️ عیب‌یابی</button>
      <button type="button" class="btn-banner-close" onclick="document.getElementById('diagnosticOfflineBanner').style.display='none';">بستن</button>
    </div>
  </div>

  <!-- ======================================================================
       MODAL: ADD NEW OPTION TO SELECT FIELD (افزودن گزینه جدید به فیلد کشویی)
       ====================================================================== -->
  <div id="modalAddOption" class="modal-overlay">
    <div class="modal-content">
      <div class="card-header">
        <div class="card-title">
          <span>➕ افزودن گزینه جدید به منوی کشویی</span>
        </div>
      </div>
      <form id="formAddOptionModal" onsubmit="return false;">
        <input type="hidden" id="modalAddOptionFieldId" value="" />
        <input type="hidden" id="modalAddOptionEntityType" value="" />
        <div class="form-group">
          <label class="form-label" id="modalAddOptionLabel">گزینه جدید</label>
          <input type="text" id="modalAddOptionValue" class="form-input" placeholder="عنوان گزینه جدید را وارد کنید..." required />
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem;">
          <button type="button" class="btn btn-outline" onclick="closeModalAddOption()">انصراف</button>
          <button type="submit" class="btn btn-primary" style="background: #0d9488;">ثبت گزینه جدید</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================================
       MODAL: ROW DETAILS & MESSAGING (نمایش جزئیات ردیف و ارسال به بله، ایتا، تلگرام، سروش، واتساپ)
       ====================================================================== -->
  <div id="modalRowDetails" class="modal-overlay">
    <div class="modal-content" style="max-width: 600px;">
      <div class="card-header">
        <div class="card-title">
          <span>📋 جزئیات کامل رکورد و ارسال مستقیم به پیام‌رسان‌ها</span>
        </div>
      </div>
      <div id="rowDetailsContentBox" style="background: #f8fafc; padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color); margin-bottom: 1.25rem; font-size: 0.9rem; line-height: 1.8;">
        <!-- Dynamic row details text -->
      </div>
      <div id="rowDetailsMiniMap" class="map-container" style="height: 200px; margin-bottom: 1.25rem;"></div>
      
      <h5 style="margin-bottom: 0.6rem; color: #1e293b;">📤 ارسال اطلاعات آماده به پیام‌رسان‌ها (با کلیک مستقیم):</h5>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <button type="button" id="btnShareBale" class="btn btn-outline btn-sm" style="background: #f0fdf4; color: #166534; border-color: #bbf7d0;">
          <span>🟢 بله (Bale)</span>
        </button>
        <button type="button" id="btnShareEitaa" class="btn btn-outline btn-sm" style="background: #fff7ed; color: #9a3412; border-color: #ffedd5;">
          <span>🟠 ایتا (Eitaa)</span>
        </button>
        <button type="button" id="btnShareTelegram" class="btn btn-outline btn-sm" style="background: #eff6ff; color: #1e40af; border-color: #bfdbfe;">
          <span>🔵 تلگرام (Telegram)</span>
        </button>
        <button type="button" id="btnShareSoroush" class="btn btn-outline btn-sm" style="background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe;">
          <span>🟣 سروش (Soroush)</span>
        </button>
        <button type="button" id="btnShareWhatsApp" class="btn btn-outline btn-sm" style="background: #ecfdf5; color: #047857; border-color: #a7f3d0;">
          <span>🟢 واتساپ (WhatsApp)</span>
        </button>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" id="btnRowCopyText" class="btn btn-primary btn-sm" style="background: #0d9488;">
            <span>📋 کپی کردن متن اطلاعات</span>
          </button>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          <button type="button" id="btnRowEdit" class="btn btn-outline btn-sm">✏️ ویرایش</button>
          <button type="button" id="btnRowDelete" class="btn btn-danger btn-sm">🗑️ حذف</button>
          <button type="button" class="btn btn-outline btn-sm" onclick="closeModalRowDetails()">✕ بستن</button>
        </div>
