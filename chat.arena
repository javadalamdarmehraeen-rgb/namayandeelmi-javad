    <!-- ======================================================================
         4. TAB: ORDERS (سفارشات) - Requirement 3: Top Alert Banner
         ====================================================================== -->
    <section id="tab-orders" class="tab-pane">
      <div id="existingPharmacyTopAlert" style="display: none;">
        <div class="alert-info-content">
          <div class="alert-info-icon">⚠️</div>
          <div class="alert-info-text">
            <h4>توجه: این داروخانه قبلاً در سیستم ثبت شده است!</h4>
            <p id="existingPharmacyAlertText">جزئیات داروخانه...</p>
          </div>
        </div>
        <div>
          <button type="button" id="btnTopAutoFillPharmacy" class="btn-autofill-pharmacy">
            <span>⚡ پر کردن خودکار فیلدها از کادر این داروخانه قبلا ثبت شده است</span>
          </button>
        </div>
      </div>
      
      <div class="card" id="cardOrdForm">
        <div class="card-header">
          <div class="card-title">
            <span>📦 ثبت سفارش جدید برای داروخانه</span>
          </div>
          <button id="btnResetOrderForm" class="btn btn-outline btn-sm">
            <span>➕ پاک کردن فرم / سفارش جدید</span>
          </button>
        </div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem;">
          <button type="button" class="btn btn-primary btn-sm" id="btnShowOrdForm" style="background: #0d9488;">فرم ثبت</button>
          <button type="button" class="btn btn-outline btn-sm" id="btnShowOrdList">لیست (<span id="ordListCountBadge">0</span>)</button>
        </div>

        <form id="formOrder" onsubmit="return false;" novalidate>
          <input type="hidden" id="orderEditId" value="" />
          <input type="hidden" id="orderPharmacyMatchedId" value="" />

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="orderPharmacyName">
                <span>نام داروخانه *</span>
              </label>
              <input type="text" id="orderPharmacyName" class="form-input" placeholder="نام داروخانه را وارد کنید..." required autocomplete="off" />
              <datalist id="pharmacyNamesList"></datalist>
              <div id="orderPharmacyPickBox" class="ph-pick-box ph-pick-overlay" hidden></div>
            </div>

            <div class="form-group">
              <label class="form-label" for="orderProvince">استان *</label>
              <select id="orderProvince" class="form-select dropdown-auto-clear">
                <option value="">انتخاب استان...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="orderCity">شهر *</label>
              <select id="orderCity" class="form-select dropdown-auto-clear">
                <option value="">ابتدا استان را انتخاب کنید</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="orderDistrict">منطقه (مرتب بدون تکرار) *</label>
              <select id="orderDistrict" class="form-select dropdown-auto-clear">
                <option value="">ابتدا شهر را انتخاب کنید</option>
              </select>
            </div>

            <div class="form-group full-width">
              <label class="form-label" for="orderAddress">آدرس داروخانه</label>
              <input type="text" id="orderAddress" class="form-input" placeholder="آدرس داروخانه..." />
            </div>

            <div class="form-group">
              <label class="form-label" for="orderRepName">نماینده علمی ثبت‌کننده</label>
              <select id="orderRepName" class="form-select dropdown-auto-clear">
                <option value="">انتخاب نماینده علمی...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="orderDate">تاریخ سفارش</label>
              <input type="text" id="orderDate" class="form-input" placeholder="1405/05/18" />
            </div>
            <div class="form-group">
              <label class="form-label" for="orderStatus">وضعیت سفارش</label>
              <select id="orderStatus" class="form-select dropdown-auto-clear">
                <option value="تایید شده">تایید شده</option>
                <option value="در حال بررسی">در حال بررسی</option>
                <option value="ارسال شده">ارسال شده</option>
                <option value="لغو شده">لغو شده</option>
              </select>
            </div>

            <div class="form-group full-width" style="background: #f8fafc; padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color);">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                <label class="form-label" style="margin: 0;">اقلام دارویی سفارش (از کالاهای ثبت‌شده + تعداد جایزه)</label>
                <button type="button" id="btnAddOrderItemRow" class="btn btn-outline btn-sm">
                  <span>➕ افزودن قلم دارویی</span>
                </button>
              </div>
              <div id="orderProductCatalogBar" class="order-catalog-bar"></div>
              <div class="order-item-head">
                <span>نام کالا</span>
                <span>تعداد کالا</span>
                <span>تعداد جایزه</span>
                <span>قیمت واحد</span>
                <span>جمع مبلغ</span>
                <span></span>
                <span></span>
              </div>
              <datalist id="orderProductCatalogList"></datalist>
              <div id="orderItemsContainer" style="display: flex; flex-direction: column; gap: 0.5rem;"></div>
              <div class="v19-order-totals">
                <div class="v19-ot-row"><span>مبلغ کل سفارش (بدون ارزش افزوده):</span> <strong id="orderTotalAmountDisplay">0</strong> ریال</div>
                <div class="v19-ot-row"><span>ارزش افزوده (<span id="orderVatPercentView">۱۰٪</span>):</span> <strong id="orderTotalVatDisplay">0</strong> ریال</div>
                <div class="v19-ot-row v19-ot-grand"><span>مبلغ کل سفارش با ارزش افزوده:</span> <strong id="orderTotalWithVatDisplay">0</strong> ریال</div>
              </div>
            </div>

            <div id="orderCustomFieldsContainer" class="form-group full-width form-grid" style="margin-top: 0.5rem;"></div>

            <div class="form-group full-width">
              <label class="form-label" for="orderNotes">توضیحات و یادداشت ارسال</label>
              <textarea id="orderNotes" class="form-textarea" placeholder="یادداشت‌های اضافی در خصوص نحوه ارسال یا تسویه..."></textarea>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1rem;">
            <button type="submit" id="btnSaveOrder" class="btn btn-primary" style="background: #0d9488;">
              <span>💾 ثبت و ذخیره سفارش</span>
            </button>
          </div>
        </form>
      </div>

      <div class="card" id="cardOrdList">
        <div class="card-header">
          <div class="card-title">
            <span>📋 لیست سفارشات ثبت شده</span>
          </div>
          <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <input type="text" id="searchOrderInput" class="form-input dropdown-auto-clear" placeholder="🔍 جستجو بر اساس نام داروخانه..." style="width: 220px;" />
            <button id="btnExportOrdersCSV" class="btn btn-success btn-sm" style="background: #0d9488;">
              <span>⬇️ خروجی اکسل</span>
            </button>
          </div>
        </div>

        <div class="table-responsive">
          <table class="data-table" id="tableOrders">
            <thead>
              <tr id="tableOrdersHeader">
                <th>ردیف</th>
                <th>نام داروخانه</th>
                <th>استان / شهر / منطقه</th>
                <th>نماینده علمی</th>
                <th>تاریخ سفارش</th>
                <th>تعداد اقلام</th>
                <th>مبلغ کل (ریال)</th>
                <th>وضعیت</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="tableOrdersBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

