    { id: "h-4", name: "بیمارستان امام رضا (ع)", type: "بیمارستان", specialty: "عمومی", province: "خراسان رضوی", city: "مشهد", district: "منطقه ۱", address: "مشهد، خیابان امام رضا", lat: 36.2870, lng: 59.6150, hours: "شبانه‌روزی" }
