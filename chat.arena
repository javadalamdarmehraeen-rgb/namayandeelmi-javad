  <script>
    window.switchTab = window.switchTab || function (targetId) {
      document.querySelectorAll("#horizontalNavContainer .nav-item").forEach(function (b) {
        b.classList.toggle("active", b.getAttribute("data-target") === targetId);
      });
      document.querySelectorAll("#sideMenuItemsContainer .side-menu-item").forEach(function (b) {
        b.classList.toggle("active", b.getAttribute("data-side-target") === targetId);
      });
      document.querySelectorAll(".tab-pane").forEach(function (p) { p.classList.remove("active"); });
      var t = document.getElementById(targetId);
      if (t) t.classList.add("active");
    };
    window.openSideMenu = window.openSideMenu || function () {
      var d = document.getElementById("sideMenuDrawer");
      var o = document.getElementById("sideMenuOverlay");
      if (d) d.classList.add("active");
      if (o) o.classList.add("active");
    };
    window.closeSideMenu = window.closeSideMenu || function () {
      var d = document.getElementById("sideMenuDrawer");
      var o = document.getElementById("sideMenuOverlay");
      if (d) d.classList.remove("active");
      if (o) o.classList.remove("active");
    };
  </script>

