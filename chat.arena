          const n = Number(v);

          if (Number.isFinite(n) && n !== 0) items[k] = n;
        }
        patch.items = items;
      }
      if (Object.keys(patch).length === 0) return Response.json({ error: "  " }, { status: 400 });
      const w = isAdmin ? eq(orders.id, id) : and(eq(orders.id, id), eq(orders.userId, user.id));
