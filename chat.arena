                      }))
                    )
                      return;
                    setProducts(products.filter((_, x) => x !== i));
                  }}
                  className="rounded-lg bg-rose-100 px-2 py-1 text-xs font-bold text-rose-700"
                >
                  
                </button>
              </div>
