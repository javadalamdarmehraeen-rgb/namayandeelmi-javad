              <label class="form-label">نام کالا *</label>
              <input type="text" id="productName" class="form-input" placeholder="مثال: کپسول امپرازول ۲۰ میلی‌گرم" required />
            </div>
            <div class="form-group">
              <label class="form-label">قیمت پخش (ریال) *</label>
              <input type="number" id="productDistPrice" class="form-input" placeholder="40000" required />
            </div>
            <div class="form-group">
              <label class="form-label">قیمت داروخانه (ریال) *</label>
              <input type="number" id="productPrice" class="form-input" placeholder="45000" required />
            </div>
            <div class="form-group">
              <label class="form-label">موجودی انبار</label>
              <input type="number" id="productStock" class="form-input" placeholder="5000" />
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" id="btnSaveProduct" class="btn btn-primary" style="background: #0d9488;">
              <span>💾 ثبت و ذخیره کالا</span>
            </button>
          </div>
        </form>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>ردیف</th>
                <th>نام کالا</th>
                <th>قیمت پخش (ریال)</th>
                <th>قیمت داروخانه (ریال)</th>
                <th>موجودی</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="tableProductsBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
