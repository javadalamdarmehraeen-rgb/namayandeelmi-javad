            <tbody id="tableMonthlyReportsBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         13. TAB: SALES TARGETS (تارگت فروش) - Menu Item 13 + Real-Time Calc
         ====================================================================== -->
    <section id="tab-sales-targets" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span>🎯 تعیین و نظارت بر تارگت فروش (KPI) به تفکیک نماینده و کالا</span>
          </div>
        </div>
        <p style="font-size: 0.88rem; color: #64748b; margin-bottom: 1.25rem;">
          بر اساس درخواست شما: با وارد کردن تعداد تارگت برای هر کالا، مبلغ تارگت (ضربدر قیمت پخش و قیمت داروخانه) به صورت لحظه‌ای محاسبه شده و در گزارش‌های سفارش از باقیمانده آن کسر می‌شود.
        </p>

        <form id="formSalesTarget" onsubmit="return false;" style="background: #f8fafc; padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color); margin-bottom: 1.5rem;">
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">نماینده علمی *</label>
              <select id="tgtRepSelect" class="form-select dropdown-auto-clear" required>
                <option value="">انتخاب نماینده...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">محصول / کالا *</label>
              <select id="tgtProductSelect" class="form-select dropdown-auto-clear" required>
                <option value="">انتخاب کالا...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">تعداد تارگت (عدد) *</label>
              <input type="number" id="tgtCountInput" class="form-input" placeholder="مثال: 500" required />
            </div>
            <div class="form-group">
              <label class="form-label">سال هدف</label>
              <input type="number" id="tgtYearInput" class="form-input" value="1405" />
            </div>
            <div class="form-group">
              <label class="form-label">ماه هدف</label>
              <select id="tgtMonthSelect" class="form-select dropdown-auto-clear">
                <option value="فروردین">فروردین</option>
                <option value="اردیبهشت">اردیبهشت</option>
                <option value="خرداد">خرداد</option>
                <option value="تیر">تیر</option>
                <option value="مرداد" selected>مرداد</option>
                <option value="شهریور">شهریور</option>
                <option value="مهر">مهر</option>
                <option value="آبان">آبان</option>
                <option value="آذر">آذر</option>
                <option value="دی">دی</option>
                <option value="بهمن">بهمن</option>
                <option value="اسفند">اسفند</option>
              </select>
            </div>
            <div class="form-group full-width" style="background: #eff6ff; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #bfdbfe; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
              <div>
                <span>مبلغ کل بر اساس قیمت پخش: </span>
                <strong id="tgtCalcDistPrice" style="color: #1e40af;">0 ریال</strong>
              </div>
              <div>
                <span>مبلغ کل بر اساس قیمت داروخانه: </span>
                <strong id="tgtCalcPhPrice" style="color: #0d9488;">0 ریال</strong>
              </div>
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="btn btn-primary" style="background: #0d9488;">
              <span>🎯 ثبت و محاسبه تارگت نماینده</span>
            </button>
          </div>
        </form>

        <div id="tgtSummaryBox" class="tgt-summary"></div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>نام نماینده علمی</th>
                <th>محصول / کالا</th>
                <th>تعداد تارگت</th>
                <th>سفارش گرفته</th>
                <th>باقیمانده</th>
                <th>مبلغ کل تارگت (ریال)</th>
                <th>درصد تحقق</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="tableSalesTargetsBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         14. TAB: CUSTOM FIELDS / ADDITIONS (افزودن‌ها) - Menu Item 14
         ====================================================================== -->
    <section id="tab-custom-fields" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span>➕ مدیریت مقادیر کشویی و افزودن‌های لحظه‌ای (Requirement 1)</span>
          </div>
        </div>
        <p style="font-size: 0.88rem; color: #64748b; margin-bottom: 1.25rem;">
          مثل ستون‌ها، اول تب را انتخاب کنید. کشویی‌های همان تب با همه گزینه‌های زیرمجموعه دیده می‌شود. روبه‌روی هر مورد ویرایش و حذف است.
        </p>
        <div id="addTabGrid" class="col-tab-grid"></div>
        <div id="addTabPanel" class="add-tab-panel"></div>
        <form id="formCustomField" onsubmit="return false;" style="background: #f8fafc; padding: 1.25rem; border-radius: var(--radius-lg); border: 1px solid var(--border-color); margin: 1.5rem 0;">
          <h4 style="margin-bottom: 1rem; color: #1e293b;">➕ افزودن فیلد جدید (ساده / تاریخ / کشویی)</h4>
          <div id="cfSaveStatus" class="col-add-status">بعد از ثبت، فیلد روی همان تب ذخیره می‌شود.</div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="cfTargetEntity">تب مربوطه *</label>
              <select id="cfTargetEntity" class="form-select dropdown-auto-clear" required>
                <option value="pharmacy">🏥 داروخانه‌ها</option>
                <option value="doctor">👨‍⚕️ پزشکان</option>
                <option value="order">📦 سفارشات</option>
                <option value="products">💊 کالاها</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="cfLabel">عنوان فیلد *</label>
              <input type="text" id="cfLabel" class="form-input" placeholder="مثال: کد اقتصادی یا نوع قرارداد" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="cfType">نوع فیلد *</label>
              <select id="cfType" class="form-select dropdown-auto-clear" required>
                <option value="simple">ساده (متنی)</option>
                <option value="date">تاریخ (با تقویم شمسی)</option>
                <option value="select">کشویی (انتخابی)</option>
              </select>
            </div>

            <div id="cfOptionsWrapper" class="form-group full-width" style="display: none;">
              <label class="form-label" for="cfOptions">گزینه‌های اولیه (با ویرگول «،» جدا کنید)</label>
              <input type="text" id="cfOptions" class="form-input" placeholder="مثال: نقدی، چکی یک‌ماهه، چکی دو‌ماهه" />
              <div style="margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" id="cfAllowAddOption" checked style="width: 18px; height: 18px;" />
                <label for="cfAllowAddOption" style="font-size: 0.85rem; font-weight: 600; color: #0d9488;">
                  امکان افزودن گزینه جدید به منوی کشویی توسط کاربر در فرم ثبت و بخش افزودن‌ها
                </label>
              </div>
            </div>

            <div class="form-group full-width">
              <label class="form-label">محل نمایش فیلد جدید</label>
              <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                  <input type="checkbox" id="cfShowInForm" checked style="width: 18px; height: 18px;" />
                  <span>نمایش در فرم ثبت</span>
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                  <input type="checkbox" id="cfShowInList" checked style="width: 18px; height: 18px;" />
                  <span>نمایش در جدول لیست</span>
                </label>
              </div>
            </div>
          </div>

          <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="button" id="btnSaveCustomField" class="btn btn-primary" style="background: #0d9488;">
              <span>➕ افزودن فیلد سفارشی</span>
            </button>
          </div>
        </form>

        <!-- v11.15: کادر «اطلاعات فیلدها» و «فهرست فشرده همه کشویی‌ها» به درخواست مدیر حذف شد.
             مدیریت گزینه‌ها از گرید تب‌های بالای همین صفحه انجام می‌شود. -->
      </div>
    </section>

    <!-- ======================================================================
         15. TAB: COLUMNS & PRODUCTS (ستون‌ها و کالاها) - Menu Item 15
