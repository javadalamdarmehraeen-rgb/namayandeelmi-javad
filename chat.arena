    <!-- ======================================================================
         15b. TAB: MANUAL TAB DESIGN (طراحی دستی تب‌ها)
         ====================================================================== -->
    <section id="tab-manual-design" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title"><span>🎨 طراحی دستی تب‌ها</span></div>
        </div>
        <p class="col-tab-hint">همه تب‌های برنامه اینجاست. روی یک تب بزنید تا همان صفحه بیاید. فیلد، کلید، کادر و نقشه را بکشید یا اندازه بدهید. می‌توانید امکانات یک تب را به تب دیگر کپی کنید. شکل نقشه ایران عوض نمی‌شود.</p>
        <div id="manualTabGrid" class="col-tab-grid"></div>
        <div class="man-toolbar">
          <p id="manualDesignHint" class="col-help">یک تب را از بالا انتخاب کنید. بعد امکانات را بزنید یا روی بوم بکشید.</p>
          <div id="manAddStatus" class="col-add-status">تب فعال: انتخاب نشده</div>
          <div id="manWidgetPalette" class="col-widget-palette"></div>
          <div id="manBoxMaker" class="col-box-maker" style="margin-top:.65rem"></div>
          <div class="man-toolbar-row">
            <button type="button" id="btnManSave" class="btn btn-primary btn-sm" style="background:#0d9488">💾 ذخیره چیدمان روی تب اصلی</button>
            <button type="button" id="btnManOpenTab" class="btn btn-outline btn-sm">باز کردن همان تب</button>
            <button type="button" id="btnManReset" class="btn btn-danger btn-sm">برگشت به چیدمان پیش‌فرض</button>
          </div>
          <div class="man-toolbar-row">
            <label>کپی از</label>
            <select id="manCopyFrom" class="form-select"></select>
            <label>به</label>
            <select id="manCopyTo" class="form-select"></select>
            <button type="button" id="btnManCopy" class="btn btn-outline btn-sm">📋 کپی امکانات و چیدمان</button>
          </div>
          <div class="man-toolbar-row man-copy-mode-row">
            <label class="man-copy-opt"><input type="radio" name="manCopyMode" id="manCopyModeAll" value="all" checked> کل امکانات تب</label>
            <label class="man-copy-opt"><input type="radio" name="manCopyMode" id="manCopyModePart" value="part"> انتخاب بخشی از امکانات</label>
          </div>
          <div id="manCopyPickList" class="man-copy-pick" hidden></div>
        </div>
        <div id="manualDesignCanvas" class="man-canvas"></div>
      </div>
    </section>

    <!-- ======================================================================
         16. TAB: USERS & PERMISSIONS (کاربران و دسترسی) - Matching Screenshots 4,5,6,7
         ====================================================================== -->
    <section id="tab-users-permissions" class="tab-pane">
      <div class="card">
        <div class="card-header" style="justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <button class="btn btn-outline btn-sm" onclick="switchTab('tab-dashboard')">→ بازگشت</button>
            <button class="btn btn-outline btn-sm" onclick="switchTab('tab-dashboard')">🏠 صفحه اصلی</button>
          </div>
          <div class="card-title" style="font-size: 1.25rem;">
            <span>کاربران، رمز عبور و سطح دسترسی 👤</span>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
          <button id="btnExportUsersCSV" class="btn btn-success btn-sm" style="background: #0d9488;">
            <span>⬇️ خروجی اکسل</span>
          </button>
          <button id="btnToggleShowAllPasswords" class="btn btn-outline btn-sm">
            <span>👁️ نمایش همه رمزها</span>
          </button>
        </div>

        <!-- CREATE NEW USER CARD (Matching Screenshot 4) -->
        <div style="background: #f8fafc; border: 1.5px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem;">
          <h4 style="margin-bottom: 1rem; color: #1e293b; font-size: 1.1rem;">ایجاد کاربر جدید</h4>

          <form id="formCreateUser" onsubmit="return false;">
            <div class="form-grid">
              <div class="form-group full-width">
                <label class="form-label">نام و نام خانوادگی *</label>
                <input type="text" id="newFullName" class="form-input" placeholder="نام کاربر..." required />
              </div>
              <div class="form-group">
                <label class="form-label">نام کاربری *</label>
                <input type="text" id="newUsername" class="form-input" placeholder="admin / davood..." required style="direction: ltr;" />
              </div>
              <div class="form-group">
                <label class="form-label">رمز عبور *</label>
                <input type="text" id="newPassword" class="form-input" placeholder="رمز عبور کاربر جدید..." required style="direction: ltr;" />
              </div>
              <div class="form-group">
                <label class="form-label">شماره همراه ورود</label>
                <input type="text" id="newPhone" class="form-input" placeholder="09120000000" style="direction: ltr;" />
              </div>
              <div class="form-group">
                <label class="form-label">نقش</label>
                <select id="newRole" class="form-select dropdown-auto-clear">
                  <option value="نماینده علمی">نماینده علمی</option>
                  <option value="مدیر سیستم">مدیر سیستم</option>
                  <option value="سرپرست">سرپرست</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">کنترل سیم‌کارت</label>
                <select id="newSimControl" class="form-select dropdown-auto-clear">
                  <option value="بدون بررسی">بدون بررسی</option>
                  <option value="قفل گوشی (توصیه شده)">قفل گوشی (توصیه شده)</option>
                </select>
              </div>
            </div>

            <!-- Permission filter pill bar matching Screenshot 4 -->
            <div style="margin-top: 1.5rem; background: #fff; padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color);">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <span style="font-weight: 700; color: #1e293b;">سطح دسترسی کاربر جدید:</span>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                  <button type="button" id="btnPermSelectAll" class="btn btn-primary btn-sm" style="background: #0d9488;">همه</button>
                  <button type="button" id="btnPermSelectNone" class="btn btn-outline btn-sm">هیچ</button>
                  <span class="badge-status-online" id="selectedPermCountBadge">۴۹ مورد</span>
                </div>
              </div>

              <!-- Permission groups container matching Screenshot 5, 6, 7 -->
              <div id="permissionGroupsContainer" style="display: flex; flex-direction: column; gap: 1.25rem;"></div>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 1.5rem; gap: 1rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: #0f172a; cursor: pointer;">
                <input type="checkbox" id="newForcePhoneLogin" checked style="width: 20px; height: 20px; accent-color: #0d9488;" />
                <span>ورود با شماره همراه اجباری باشد</span>
              </label>
              <button type="submit" class="btn btn-primary" style="background: #0d9488; font-size: 1rem; padding: 0.75rem 2rem;">
                <span>➕ ایجاد کاربر</span>
              </button>
            </div>
          </form>
        </div>

        <!-- USERS LIST CARDS matching Screenshot 4, 7 (مدیر سیستم، جواد علمدار، خانم نیلا محرمی، آقای داوود عقبایی) -->
        <h4 style="margin-bottom: 1rem; color: #1e293b;">فهرست کاربران و سطح دسترسی فعال</h4>
        <div id="userCardsContainer" style="display: flex; flex-direction: column; gap: 1.25rem;"></div>
      </div>
    </section>

    <!-- ======================================================================
         17. TAB: MESSENGERS (پیام‌رسان‌ها) - Menu Item 17
         ====================================================================== -->
    <section id="tab-messengers" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span>💬 تنظیمات اتصال به پیام‌رسان‌ها (پیامک، تلگرام، ایتا و واتساپ)</span>
          </div>
