// دریافت یک آبجکت حاوی کلیه دسترسی‌ها با مقدار پیش‌فرض true یا false
function getDefaultPermissionsObject(defaultValue = true) {
  const perms = {};
  Object.values(PERMISSION_GROUPS).forEach(list => {
    list.forEach(item => {
      perms[item.key] = defaultValue;
    });
  });
  return perms;
}

