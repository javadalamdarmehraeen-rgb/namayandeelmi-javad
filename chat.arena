  <!-- ======================================================================
       MODAL: LOGIN & ROLE SWITCHING (ورود و تغییر نقش کاربری)
       ====================================================================== -->
  <div id="modalLogin" class="modal-overlay">
    <div class="modal-content" style="max-width: 480px;">
      <div style="text-align: center; margin-bottom: 1rem;">
        <img src="logo.png" alt="TENIN TEB TAHA" class="login-logo-img" />
      </div>
      <div class="card-header">
        <div class="card-title">
          <span>🔐 ورود به سیستم / تغییر نقش کاربری</span>
        </div>
      </div>
      <p style="font-size: 0.88rem; color: #64748b; margin-bottom: 1.25rem;">
        نقش کاربری خود را انتخاب کنید تا دسترسی‌های تعیین‌شده در بخش «👤 کاربران و دسترسی» به صورت هوشمند برای شما اعمال شود:
      </p>
      <form id="formLoginModal" onsubmit="return false;">
        <div class="form-group">
          <label class="form-label" for="loginUsernameInput">نام کاربری *</label>
          <input type="text" id="loginUsernameInput" class="form-input" placeholder="admin" style="direction: ltr;" autocomplete="username" />
        </div>
        <div class="form-group" style="margin-top: 0.5rem;">
          <label class="form-label" for="loginPasswordInput">رمز عبور *</label>
          <input type="password" id="loginPasswordInput" class="form-input" placeholder="رمز عبور" style="direction: ltr;" autocomplete="current-password" />
        </div>
        <div class="form-group" style="margin-top: 0.5rem;">
          <label class="form-label" for="loginRoleSelect">نقش کاربری *</label>
          <select id="loginRoleSelect" class="form-select dropdown-auto-clear" required>
            <option value="0">مدیر سیستم (Admin)</option>
            <option value="1">جواد علمدار (نماینده علمی)</option>
            <option value="2">خانم نیلا محرمی (نماینده علمی)</option>
            <option value="3">آقای داوود عقبایی (سرپرست)</option>
          </select>
        </div>
        <div class="form-group" style="margin-top: 0.5rem;">
          <label class="form-label" for="loginUserName">شماره همراه ورود</label>
          <input type="text" id="loginUserName" class="form-input" value="09120000000" style="direction: ltr;" />
        </div>
        <div class="form-group" style="margin-top: 0.5rem;">
          <label class="form-label" for="loginSimAuthMode">حالت تایید دو مرحله‌ای سیم‌کارت (تنظیم مدیر)</label>
          <select id="loginSimAuthMode" class="form-select dropdown-auto-clear">
            <option value="3">۳. ورود عادی (غیرفعال بودن تایید دو مرحله‌ای)</option>
            <option value="1">۱. دریافت پیامک رمز یک‌بارمصرف (OTP SMS)</option>
            <option value="2">۲. ارسال کد تایید به مدیر سیستم</option>
          </select>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
          <button type="button" class="btn btn-outline" onclick="closeModalLogin()">انصراف</button>
          <button type="submit" class="btn btn-primary" style="background: #0d9488;">
            <span>🚀 ورود و اعمال سطح دسترسی</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ======================================================================
       PERSIAN JALALI CALENDAR POPUP PICKER (تقویم تعاملی شمسی هماهنگ با اسکرین‌شات)
       ====================================================================== -->
  <div id="jalaliCalendarPopup" class="jalali-popup-picker">
    <div class="jalali-picker-header">
      <button type="button" class="jalali-nav-arrow" id="jalaliPrevMonth">&gt;</button>
      <div class="jalali-header-selects">
        <select id="jalaliYearSelect" class="jalali-select">
          <option value="1404">۱۴۰۴</option>
          <option value="1405" selected>۱۴۰۵</option>
