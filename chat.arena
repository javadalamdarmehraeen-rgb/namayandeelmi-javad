    <!-- ======================================================================
         10. TAB: LEAVES (مرخصی‌ها) - Menu Item 10 + Hourly/Daily + 2-Tier Approval
         ====================================================================== -->
    <section id="tab-leaves" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span>📝 مدیریت درخواست‌های مرخصی و مأموریت (با دو تاییدیه سرپرست و مدیر کل)</span>
          </div>
          <button id="btnExportLeavesCSV" class="btn btn-success btn-sm" style="background: #0d9488;">
            <span>⬇️ خروجی اکسل مرخصی‌ها</span>
          </button>
        </div>

 10px; border: 1px solid var(--border-color); margin-bottom: 1.5rem;">
          <h4 style="margin-bottom: 1rem; color: #1e293b;">📝 ثبت درخواست مرخصی / مأموریت جدید</h4>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">نام نماینده *</label>
              <select id="leaveRepSelect" class="form-select dropdown-auto-clear" required>
                <option value="">انتخاب نماینده...</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">نوع مرخصی *</label>
              <select id="leaveTypeSelect" class="form-select dropdown-auto-clear" required>
                <option value="روزانه (استحقاقی)">روزانه (استحقاقی)</option>
                <option value="روزانه (استعلاجی)">روزانه (استعلاجی)</option>
                <option value="ساعتی">مرخصی ساعتی</option>
                <option value="مأموریت اداری">مأموریت اداری</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">از تاریخ * (با اسلش خودکار)</label>
              <input type="text" id="leaveFromDate" class="form-input" placeholder="1405/05/22" required />
            </div>
            <div class="form-group">
              <label class="form-label">تا تاریخ *</label>
              <input type="text" id="leaveToDate" class="form-input" placeholder="1405/05/23" required />
            </div>
            <div class="form-group" id="leaveHoursGroup" style="display: none;">
              <label class="form-label">ساعت مرخصی (از ساعت - تا ساعت)</label>
              <input type="text" id="leaveHoursInput" class="form-input" placeholder="مثال: از ۰۹:۰۰ تا ۱۲:۰۰" />
            </div>
            <div class="form-group full-width">
              <label class="form-label">توضیحات و دلیل مرخصی *</label>
              <input type="text" id="leaveReasonInput" class="form-input" placeholder="علت درخواست مرخصی یا مأموریت..." required />
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="btn btn-primary" style="background: #0d9488;">
              <span>📝 ثبت درخواست مرخصی</span>
            </button>
          </div>
        </form>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>نام نماینده علمی</th>
                <th>نوع مرخصی</th>
                <th>از تاریخ / ساعت</th>
                <th>تا تاریخ</th>
                <th>دلیل</th>
                <th>تایید سرپرست</th>
                <th>تایید مدیر کل</th>
                <th>عملیات</th>
              </tr>
            </thead>
