              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         11. TAB: NOTIFICATIONS (اعلان‌ها) - Menu Item 11 + Send/Reply Message
         ====================================================================== -->
    <section id="tab-notifications" class="tab-pane">
      <div class="card">
        <div class="card-header">
          <div class="card-title">
            <span>🔔 ارسال و مشاهده اعلان‌ها و پیام‌رسانی داخلی (امکان ارسال و پاسخ پیام)</span>
          </div>
        </div>

        <!-- Send / Reply Message Box -->
        <form id="formSendMessage" onsubmit="return false;" style="background: #f8fafc; padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color); margin-bottom: 1.5rem;">
          <h4 style="margin-bottom: 1rem; color: #1e293b;">💬 ارسال پیام جدید / پاسخ به پیام در اعلان‌ها</h4>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">گیرنده پیام *</label>
              <select id="msgRecipientSelect" class="form-select dropdown-auto-clear" required>
                <option value="همه کاربران (اعلان عمومی)">همه کاربران (اعلان عمومی)</option>
                <option value="مدیر سیستم">مدیر سیستم (Admin)</option>
                <option value="جواد علمدار">جواد علمدار (نماینده علمی)</option>
                <option value="خانم نیلا محرمی">خانم نیلا محرمی (نماینده علمی)</option>
                <option value="آقای داوود عقبایی">آقای داوود عقبایی (سرپرست)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">عنوان پیام / اعلان *</label>
              <input type="text" id="msgTitleInput" class="form-input" placeholder="مثال: پاسخ مرخصی یا اعلام تارگت..." required />
            </div>
            <div class="form-group full-width">
              <label class="form-label">متن پیام *</label>
              <input type="text" id="msgBodyInput" class="form-input" placeholder="متن کامل پیام یا پاسخ خود را تایپ کنید..." required />
            </div>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
            <button type="submit" class="btn btn-primary" style="background: #0d9488;">
              <span>📤 ارسال پیام و اعلان (با صدای هشدار)</span>
            </button>
          </div>
        </form>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>تاریخ ارسال</th>
                <th>عنوان اعلان</th>
                <th>متن پیام</th>
                <th>فرستنده / گیرنده</th>
                <th>وضعیت</th>
                <th>عملیات</th>
              </tr>
            </thead>
            <tbody id="tableNotificationsBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================================================================
