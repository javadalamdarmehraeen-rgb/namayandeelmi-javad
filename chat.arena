          <option value="12">اسفند</option>
        </select>
      </div>
      <button type="button" class="jalali-nav-arrow" id="jalaliNextMonth">&lt;</button>
    </div>
    <div class="jalali-weekdays">
      <div>ش</div><div>ی</div><div>د</div><div>س</div><div>چ</div><div>پ</div><div>ج</div>
    </div>
    <div id="jalaliDaysGrid" class="jalali-days-grid"></div>
    <button type="button" id="jalaliTodayBtn" class="jalali-today-btn">امروز: ۱۴۰۵/۰۵/۲۲</button>
  </div>

