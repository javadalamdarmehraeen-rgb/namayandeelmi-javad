# ============================================================
#  متغیرهای محیطی سرور داخلی — NdcoHub.ir (نت‌افراز)
#  این فایل را کپی کرده و با نام .env روی هاست قرار دهید
# ============================================================

# --- دیتابیس این سرور (مستقل از Render) ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require

# --- هویت این گره ---
NODE_NAME=ndcohub
PUBLIC_BASE_URL=https://ndcohub.ir

# --- همگام‌سازی با سرور دیگر ---
# باید روی هر دو سرور دقیقاً یکسان باشد
SYNC_SECRET=یک-کلید-تصادفی-بلند-و-یکسان-روی-هر-دو-سرور
SYNC_PEERS=render|https://namayandeelmi-javad.onrender.com
SYNC_INTERVAL_MINUTES=5

# --- آدرس‌هایی که کلاینت بین آن‌ها جابه‌جا می‌شود ---
NEXT_PUBLIC_ENDPOINTS=https://ndcohub.ir,https://namayandeelmi-javad.onrender.com

# --- امنیت ---
APP_SECRET=یک-کلید-تصادفی-بلند
MOBILE_APP_SECRET=همان-کلیدی-که-در-اپ-موبایل-گذاشتید

# --- اختیاری ---
ADMIN_PASSWORD=admin1234
ADMIN_PHONE=09120000000
BALE_BOT_TOKEN=
SMS_API_KEY=
